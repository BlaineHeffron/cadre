{
  "name": "@blaineheffron/cadre",
  "version": "0.1.0",
  "description": "Self-hosted control plane for running, coordinating and monitoring coding-agent sessions (Claude Code, Codex, Pi) with an agent bus, MCP catalog, launch skills and Telegram remote control.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "check:node": "node scripts/check-node-runtime.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --reporter=json --reporter=text-summary --report-dir .quality/repo-quality/cov --include 'modules/**' --include 'lib/**' --include server.mjs --include config.mjs node scripts/run-tests.mjs --test-reporter=dot",
    "quality:crap": "node scripts/repo-quality-check.mjs",
    "quality:crap:update": "node scripts/repo-quality-check.mjs --update-baseline",
    "quality:mutants": "CADRE_DISABLE_SIDE_EFFECTS=1 CADRE_GITHUB_AGENT_POLLER_ENABLED=0 CADRE_GITHUB_AGENTS_ENABLED=0 CADRE_SCHEDULED_AGENT_PUMP_ENABLED=0 TELEGRAM_BRIDGE=0 node scripts/repo-quality-check.mjs --mutation-only",
    "migrate:postgres-state": "node scripts/migrate-state-to-postgres.mjs",
    "backup:state": "node scripts/backup-state.mjs",
    "backup:restore": "node scripts/restore-state-from-backup.mjs",
    "backup:verify": "node scripts/verify-backup-restore.mjs",
    "setup": "bash scripts/setup-certs.sh && bash scripts/generate-token.sh"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-acp-demo": "0.1.0-rc.8",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.8",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.8",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.8",
    "@deepseek-ai/dsh-repeat-tool-reminder": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-ralph": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-subagent-control": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-subagent-report": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-todo": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-workflow": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workflow-worker-thread": "0.1.0-rc.8",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "0.0.82",
    "@preact/signals": "^2.9.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.4.0",
    "fastify": "5.12.5",
    "htm": "^3.1.1",
    "js-yaml": "4.3.2",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "pg": "^8.16.0",
    "preact": "^10.29.1",
    "preact-router": "^4.1.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "jscpd": "4.3.0",
    "playwright-core": "^1.59.1"
  },
  "private": true
}
