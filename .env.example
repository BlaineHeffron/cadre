# Server
HOST=0.0.0.0
PORT=3000
TLS_ENABLED=1
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
# Agent Bus MCP verifies HTTPS by default. Set to 1 only for local/self-signed monitor certs.
CADRE_MONITOR_ALLOW_INSECURE_TLS=0

# Auth — these three must be set and pairwise distinct or the server refuses to start.
AUTH_TOKEN=changeme
INTERNAL_BYPASS_TOKEN=change-bypass
BROWSER_SESSION_SECRET=change-session
CADRE_AGENT_BUS_MCP_AUTH=issue_only
CADRE_PREAPPROVED_AUTOMATION_POLICIES=
# Query-string WebSocket token auth is disabled by default.
# Set to 1 only for temporary legacy client migration.
WS_QUERY_TOKEN_COMPAT=0
AGENT_SESSION_IDEMPOTENCY_TTL_MS=3600000

# Research Workbench (local Zotero bridge; loopback only)
RESEARCH_WORKBENCH_FLEET_BASE_URL=http://127.0.0.1:4310
RESEARCH_WORKBENCH_FLEET_TOKEN_FILE=~/.research-workbench/fleet-bridge.json
RESEARCH_WORKBENCH_DEFAULT_WORKDIR=
RESEARCH_WORKBENCH_ALLOWED_WORKDIRS=

# Pi CLI (optional; defaults to pi on PATH)
PI_BIN=pi

# Experimental Claude stream-json transport. Keep disabled to use tmux.
CLAUDE_STREAM_JSON_ENABLED=0

# BusinessOS MCP (optional; opt-in per launched agent)
# Prefer a dedicated, revocable, scoped operator_users personal token.
BUSINESSOS_MCP_URL=
BUSINESSOS_MCP_OPERATOR_TOKEN=
BUSINESSOS_MCP_PROXY_PATH_PREFIX=/businessos-mcp
AGENT_BUS_MCP_HTTP_HOST=127.0.0.1

# Optional extra prompt-profile catalog entries (JSON object of id -> {label,description,placement,template})
CADRE_PROMPT_PROFILES_JSON=
# Fleet-owned launch skill markdown directory. Selected skills are pasted as startup text.
CADRE_LAUNCH_SKILLS_DIR=config/skills

# Logging
LOG_LEVEL=info

# Persistence
# Set APP_STATE_STORAGE=postgres to persist JSON-backed stores in PostgreSQL.
# Keep as "file" to use local JSON files only.
APP_STATE_STORAGE=file
DATABASE_URL=
DATABASE_SSL=false

# File browser root directory (default: ~/projects)
FILE_BROWSER_ROOT=

# Fleet
CADRE_COMMAND_CENTER_DEPLOYMENT_REGISTRY_PATH=config/fleet-registry.json
CADRE_COMMAND_CENTER_REMOTE_BASE_URL_REFS_ENABLED=1
CADRE_COMMAND_CENTER_FLEET_LIVE_REMOTE_POLLING_ENABLED=1
DM_FLEET_PRIVATE_HOSTS_REF=DM_FLEET_PRIVATE_HOSTS
CADRE_FLEET_PRIVATE_HOSTS=host.example.ts.net
CADRE_PUBLIC_BASE_URL_REF=https://host.example.ts.net
CADRE_FLEET_AUTH_REF=replace-with-readonly-token
CADRE_FLEET_REPO_PATHS_JSON={}

# Third-party MCP (see docs/mcp-servers.md)
CADRE_MCP_OAUTH_PUBLIC_BASE_URL=
CADRE_MCP_SLACK_MODE=local
CADRE_MCP_SLACK_LOCAL_URL=http://127.0.0.1:13080/mcp
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=
# SLACK_MCP_ADD_MESSAGE_TOOL=true

# GitHub agents
CADRE_GITHUB_AGENT_POLLER_ENABLED=0
# MODEL defaults from the resolved provider when unset. Pin both together.
CADRE_GITHUB_AGENT_PROVIDER=codex
CADRE_GITHUB_AGENT_MODEL=gpt-6-sol
CADRE_GITHUB_AGENT_THINKING_LEVEL=low
CADRE_GITHUB_AGENT_REPO_PATHS_JSON={}
GITHUB_FLEET_TOKEN=replace-with-github-token

# Local Google Workspace MCP (scripts/google-workspace-mcp.sh)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# CADRE_MCP_GOOGLE_MODE=local
# CADRE_MCP_GOOGLE_LOCAL_URL=http://127.0.0.1:8000/mcp
# Default mailbox for every gmail/drive/docs/calendar tool. Agents should omit
# user_google_email or pass this exact address. The server still honors a
# caller-supplied different address and will start a new OAuth flow for it.
# USER_GOOGLE_EMAIL=
