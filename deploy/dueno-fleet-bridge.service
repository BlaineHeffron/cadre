[Unit]
Description=Cadre authenticated service-out API bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5
# Fail closed if the operator-installed tree is missing. Never bind a live checkout.
ConditionPathExists=/opt/dueno-fleet-bridge/fleet-bridge.mjs

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/
# Required, separate root-owned 0600 file; never load the Fleet .env here.
EnvironmentFile=/etc/dueno-fleet-bridge/bridge.conf
Environment=DUENO_BRIDGE_PORT=4311
Environment=DUENO_BRIDGE_UPSTREAM=http://127.0.0.1:4310
ExecStart=/opt/dueno-fleet-bridge/node /opt/dueno-fleet-bridge/fleet-bridge.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
LockPersonality=yes
TasksMax=64
MemoryMax=256M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
